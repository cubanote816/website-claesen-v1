# API Configuration
PUBLIC_API_URL=https://backend.claesen-verlichting.be/v1/website
PUBLIC_API_BASE_URL=https://backend.claesen-verlichting.be/api

# Site URL (for sitemap, OG tags, hreflang)
PUBLIC_SITE_URL=https://claesen-verlichting.be

# Static fallback — safety net only, API is always attempted first.
# Set to "false" to disable entirely (e.g., in CI environments without static assets).
PUBLIC_ENABLE_STATIC_FALLBACK=true

# Webhook server (npm run webhook)
# Secret token the backend must send in the X-Webhook-Secret header.
WEBHOOK_SECRET=change-me-to-a-strong-random-string
# Port the webhook server listens on (default: 9000).
WEBHOOK_PORT=9000
# Astro build mode triggered by the webhook (default: production).
WEBHOOK_BUILD_MODE=production
# Optional shell command to run after a successful build (e.g. copy dist to web root).
# WEBHOOK_DEPLOY_CMD=cp -r dist/. /var/www/claesen-verlichting/v1/
