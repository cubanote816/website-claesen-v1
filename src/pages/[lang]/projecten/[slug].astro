---
import ProjectDetailPage from '../../../components/pages/ProjectDetailPage.astro';
import { ui } from '../../../i18n/ui';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
    const jsonPath = path.join(process.cwd(), 'public/v1-media/projects-static.json');
    let projects: any[] = [];
    try {
        const data = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
        projects = data.projects || data || [];
    } catch {}

    const langs = Object.keys(ui).filter(l => l !== 'nl');
    return langs.flatMap(lang =>
        projects
            .filter((p: any) => p.slug)
            .map((p: any) => ({
                params: { lang, slug: p.slug },
                props: { project: p, lang },
            }))
    );
}

const { project, lang } = Astro.props;
---

<ProjectDetailPage project={project} lang={lang} />
