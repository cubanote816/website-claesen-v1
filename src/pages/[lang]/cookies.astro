---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader';
import { legalContent } from '../../i18n/legal';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const content = legalContent[lang as keyof typeof legalContent].cookies;
---

<Layout title={`${content.title} - Claesen Verlichting`} lang={lang}>
    {/* Background Grid/Noise (Fixed) */}
    <div class="fixed inset-0 z-0 pointer-events-none opacity-20"
         style={{
           backgroundImage: 'url("data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.05\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")'
         }}
    ></div>

    <div class="pt-32 relative z-10">
        <PageHeader 
            client:load 
            title={content.title} 
            subtitle={content.subtitle}
        />
    </div>

    <section class="py-20 px-6 relative z-10">
        <div class="max-w-4xl mx-auto glass-panel rounded-3xl p-8 md:p-12">
            <div class="prose prose-invert prose-lg max-w-none prose-headings:font-display prose-headings:text-white prose-p:text-cool-slate prose-a:text-lux-gold hover:prose-a:text-white transition-colors">
                <p class="text-sm text-cool-slate/60 mb-8 border-b border-white/10 pb-4">Last updated: {new Date().toLocaleDateString()}</p>

                <p>{content.content}</p>

                <h3>{content.types.title}</h3>
                <ul>
                    {content.types.items.map(item => (
                        <li><strong>{item.label}:</strong> {item.text}</li>
                    ))}
                </ul>

                <h3>Contact Us</h3>
                <p>
                    If you have questions about this policy, please contact us at info@claesen-verlichting.be.
                </p>
                <p>
                    <strong>Claesen Verlichting</strong><br/>
                    Benoit Jansenstraat 4<br/>
                    2490 Balen, België<br/>
                    info@claesen-verlichting.be
                </p>
            </div>
        </div>
    </section>

    <Footer lang={lang as keyof typeof ui} />
</Layout>
