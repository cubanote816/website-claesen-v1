---
import { twMerge } from "tailwind-merge";
import { ui, defaultLang } from "../i18n/ui";

interface Props {
    lang?: string;
}

const { lang = defaultLang } = Astro.props;

// Translation helper
// @ts-ignore
const t = ui[lang] || ui[defaultLang];

// Link helper
const baseUrl =
    import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL;
const gl = (path: string) => {
    const route = lang === defaultLang ? path : `/${lang}${path}`;
    return `${baseUrl}${route}`;
};

const navItems = [
    { name: t["nav.home"], href: gl("/#home"), section: "home" },
    { name: t["nav.projects"], href: gl("/#projects"), section: "projects" },
    { name: t["nav.services"], href: gl("/#services"), section: "services" },
    { name: t["nav.about"], href: gl("/#about"), section: "about" },
];
---

<nav
    id="classic-nav"
    class="fixed top-0 left-0 w-full z-50 transition-all duration-300 border-b border-white/5 bg-transparent py-3 md:py-6"
>
    <div
        class="max-w-7xl mx-auto px-4 md:px-6 flex items-center justify-between h-full"
    >
        {/* Brand */}
        <a
            href={gl("/#home")}
            class="flex items-center gap-2 group nav-link-home z-[70] relative"
        >
            <img
                src="/assets/brand-logo-dark.png"
                alt="Claesen Verlichting"
                class="h-6 md:h-8 w-auto opacity-90 group-hover:opacity-100 transition-opacity"
            />
        </a>

        {/* Desktop Navigation Links */}
        <div class="hidden lg:flex items-center gap-8">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        data-section={item.section}
                        class="nav-item text-sm font-medium tracking-wide uppercase relative py-1 transition-colors text-white/70 hover:text-white"
                    >
                        {item.name}
                        <span class="nav-underline absolute bottom-0 left-0 w-full h-[2px] bg-lux-gold scale-x-0 transition-transform duration-300 origin-left" />
                    </a>
                ))
            }
        </div>

        {/* Right Side: Language & CTA (Desktop) */}
        <div class="hidden lg:flex items-center gap-6">
            <div
                class="flex items-center gap-4 border-r border-white/10 pr-6 mr-1"
            >
                <a
                    href={`tel:${(t["nav.phone"] || "").replace(/\s/g, "")}`}
                    class="flex items-center gap-2 text-white/50 hover:text-lux-gold transition-all text-[11px] font-bold tracking-widest"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-phone-call opacity-70"
                        ><path
                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                        ></path><path d="M14.05 2a9 9 0 0 1 8 8"></path><path
                            d="M14.05 6A5 5 0 0 1 18 10"></path></svg
                    >
                    <span class="hidden xl:inline uppercase"
                        >{t["nav.phone"]}</span
                    >
                </a>

                <div class="flex items-center gap-1">
                    {
                        ["nl", "en", "fr", "de"].map((l) => {
                            // Logic to get current path relative to current language
                            const languages = ["en", "fr", "de"]; // nl is default
                            let pathSegments = Astro.url.pathname
                                .split("/")
                                .filter(Boolean);

                            // Remove base segments if they exist (e.g., ['v1'])
                            const baseSegments = baseUrl
                                .split("/")
                                .filter(Boolean);
                            if (
                                pathSegments
                                    .slice(0, baseSegments.length)
                                    .join("/") === baseSegments.join("/")
                            ) {
                                pathSegments = pathSegments.slice(
                                    baseSegments.length,
                                );
                            }

                            // Remove current language segment if it exists
                            if (languages.includes(pathSegments[0])) {
                                pathSegments.shift();
                            }

                            // Construct new path
                            const finalSegments =
                                l === "nl"
                                    ? pathSegments
                                    : [l, ...pathSegments];
                            const newPath =
                                `${baseUrl}/${finalSegments.join("/")}`.replace(
                                    /\/+$/,
                                    "",
                                ) || `${baseUrl}/`;

                            return (
                                <a
                                    href={newPath}
                                    class={twMerge(
                                        "text-xs font-bold px-2 py-1 rounded hover:bg-white/10 transition-colors lang-switch",
                                        lang === l
                                            ? "text-lux-gold bg-white/5"
                                            : "text-white/50",
                                    )}
                                >
                                    {l.toUpperCase()}
                                </a>
                            );
                        })
                    }
                </div>
            </div>

            <a
                href={gl("/#contact")}
                class="bg-lux-gold text-obsidian px-6 py-2.5 text-sm font-bold uppercase tracking-wider rounded-full hover:bg-white hover:scale-105 transition-all duration-300 shadow-[0_0_15px_rgba(212,175,55,0.2)] flex items-center gap-2"
            >
                <span class="w-2 h-2 rounded-full bg-obsidian animate-pulse"
                ></span>
                {t["nav.cta"]}
            </a>
        </div>

        {/* Mobile Toggle Button */}
        <button
            id="mobile-toggle"
            class="lg:hidden z-[70] relative p-4 -mr-2 text-white hover:text-lux-gold transition-colors focus:outline-none touch-manipulation"
            aria-label="Toggle Menu"
            aria-expanded="false"
        >
            <div
                class="w-6 h-5 flex flex-col justify-between pointer-events-none"
            >
                <span
                    class="w-full h-0.5 bg-white transform transition-transform duration-300 origin-center"
                    id="hamburger-top"></span>
                <span
                    class="w-full h-0.5 bg-white transition-opacity duration-300"
                    id="hamburger-mid"></span>
                <span
                    class="w-full h-0.5 bg-white transform transition-transform duration-300 origin-center"
                    id="hamburger-bot"></span>
            </div>
        </button>
    </div>
</nav>

{
    /* Mobile Menu Overlay - Moved outside nav to avoid backdrop-filter containing block issues */
}
<div
    id="mobile-menu"
    class="fixed inset-0 bg-obsidian/98 backdrop-blur-xl z-[9999] flex flex-col justify-center items-center opacity-0 pointer-events-none transition-all duration-300"
>
    {/* Mobile Links */}
    <div class="flex flex-col items-center gap-8 mb-12">
        {
            navItems.map((item) => (
                <a
                    href={item.href}
                    class="mobile-nav-link text-3xl font-display font-medium text-white/80 hover:text-lux-gold transition-colors"
                    data-section={item.section}
                >
                    {item.name}
                </a>
            ))
        }
    </div>

    {/* Mobile Language Switcher */}
    <div class="flex items-center gap-4 mb-10">
        {
            ["nl", "en", "fr", "de"].map((l) => {
                const languages = ["en", "fr", "de"];
                let pathSegments = Astro.url.pathname
                    .split("/")
                    .filter(Boolean);
                const baseSegments = baseUrl.split("/").filter(Boolean);
                if (
                    pathSegments.slice(0, baseSegments.length).join("/") ===
                    baseSegments.join("/")
                ) {
                    pathSegments = pathSegments.slice(baseSegments.length);
                }
                if (languages.includes(pathSegments[0])) {
                    pathSegments.shift();
                }
                const finalSegments =
                    l === "nl" ? pathSegments : [l, ...pathSegments];
                const newPath =
                    `${baseUrl}/${finalSegments.join("/")}`.replace(
                        /\/+$/,
                        "",
                    ) || `${baseUrl}/`;

                return (
                    <a
                        href={newPath}
                        class={twMerge(
                            "text-lg font-bold px-3 py-2 rounded border border-white/10 transition-all lang-switch",
                            lang === l
                                ? "bg-lux-gold text-obsidian border-lux-gold"
                                : "text-white/50 hover:bg-white/5",
                        )}
                    >
                        {l.toUpperCase()}
                    </a>
                );
            })
        }
    </div>

    <div class="flex flex-col items-center gap-6 mb-10">
        <a
            href={`tel:${(t["nav.phone"] || "").replace(/\s/g, "")}`}
            class="flex items-center gap-3 text-white text-2xl font-bold"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-phone-call text-lux-gold"
                ><path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path><path d="M14.05 2a9 9 0 0 1 8 8"></path><path
                    d="M14.05 6A5 5 0 0 1 18 10"></path></svg
            >
            {t["nav.phone"]}
        </a>
    </div>

    <a
        href={gl("/#contact")}
        class="mobile-cta bg-lux-gold text-obsidian px-10 py-4 text-xl font-bold uppercase tracking-wider rounded-full shadow-lg shadow-lux-gold/20 flex items-center gap-3"
    >
        <span class="w-2.5 h-2.5 rounded-full bg-obsidian animate-pulse"></span>
        {t["nav.cta"]}
    </a>
</div>

<style>
    /* 
      We remove the global height: 100vh rule as it causes scroll jumping.
      We will handle scroll locking in JS via position: fixed on body.
    */
</style>

<script>
    import "../scripts/nav";
</script>
