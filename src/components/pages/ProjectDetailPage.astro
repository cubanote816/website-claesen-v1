---
import Layout from '../../layouts/Layout.astro';
import { ui, defaultLang } from '../../i18n/ui';
import DetailGallery from '../DetailGallery';
import WerfGallery from '../WerfGallery';
import ProjectLiveContent from '../ProjectLiveContent';

interface Props {
    project: any;
    lang?: string;
}

const { project: raw, lang = defaultLang } = Astro.props;
const t = ui[lang as keyof typeof ui] || ui[defaultLang];

function getStr(val: any): string {
    if (typeof val === 'string') return val;
    if (!val) return '';
    return val[lang] || val['nl'] || val['en'] || '';
}

function getImageUrl(val: any): string {
    if (!val) return '';
    if (typeof val === 'string') return val;
    return val.optimized || val.original || val.url || val.original_url || val.thumb || '';
}

const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');

function resolveImageUrl(url: string): string {
    if (!url || url.startsWith('http')) return url;
    return `${basePath}${url}`;
}

const title       = getStr(raw.title);
const description = getStr(raw.description);
const location    = getStr(raw.location);
const client      = getStr(raw.client);
const category    = raw.category || '';
const year        = raw.year;
const featuredUrl = resolveImageUrl(getImageUrl(raw.featured_image_url || raw.featured_image));

const rawGallery: any[] = Array.isArray(raw.gallery) && raw.gallery.length > 0
    ? raw.gallery
    : (Array.isArray(raw.api_gallery) ? raw.api_gallery : []);

const gallery = rawGallery
    .map((img: any) => ({
        url:   resolveImageUrl(img.url || img.thumb || img.optimized || img.original || ''),
        thumb: resolveImageUrl(img.thumb || img.url || img.optimized || img.original || ''),
        alt:   img.alt || title,
    }))
    .filter((img: any) => img.url);

// Work-details fields (website-work-details API)
// Texts may contain HTML — rendered with set:html, same pattern as description.
const workStory = getStr(raw.work_story);
const challenge = getStr(raw.challenge);
const solution  = getStr(raw.solution);
const result    = getStr(raw.result);

const rawDetailGallery: any[] = Array.isArray(raw.detail_gallery) ? raw.detail_gallery : [];
const detailGallery = rawDetailGallery
    .map((img: any) => ({
        url:   resolveImageUrl(img.url || img.optimized || img.original_url || img.original || ''),
        thumb: resolveImageUrl(img.thumb || img.thumb_url || img.url || img.optimized || img.original || ''),
        alt:   img.alt || title,
    }))
    .filter((img: any) => img.url);

const backUrl = lang === defaultLang
    ? `${basePath}/#projects`
    : `${basePath}/${lang}/#projects`;
const ctaUrl = lang === defaultLang
    ? `${basePath}/#contact`
    : `${basePath}/${lang}/#contact`;

const SITE_URL    = (import.meta.env.PUBLIC_SITE_URL || 'https://claesen-verlichting.be').replace(/\/$/, '');
const pageTitle   = `${title} — Claesen Verlichting`;
const pageMeta    = description.replace(/<[^>]+>/g, '').slice(0, 160);
const pageOgImage = featuredUrl || `${SITE_URL}${basePath}/assets/hero-bg.jpg`;
const pageSlug    = lang === defaultLang
    ? `/projecten/${raw.slug}`
    : `/${lang}/projecten/${raw.slug}`;

const categoryLabels: Record<string, Record<string, string>> = {
    sport:      { nl: 'Sport',           en: 'Sport',         fr: 'Sport',          de: 'Sport'              },
    industrial: { nl: 'Industrieel',     en: 'Industrial',    fr: 'Industriel',     de: 'Industrie'          },
    public:     { nl: 'Publieke Ruimte', en: 'Public Space',  fr: 'Espace Public',  de: 'Öffentlicher Raum'  },
};
const categoryLabel = categoryLabels[category]?.[lang] || category;

const sidebarLabels: Record<string, Record<string, string>> = {
    category: { nl: 'Categorie', en: 'Category',  fr: 'Catégorie', de: 'Kategorie' },
    location: { nl: 'Locatie',   en: 'Location',  fr: 'Lieu',      de: 'Standort'  },
    year:     { nl: 'Jaar',      en: 'Year',      fr: 'Année',     de: 'Jahr'      },
    client:   { nl: 'Klant',     en: 'Client',    fr: 'Client',    de: 'Kunde'     },
};
const l = (key: string) => sidebarLabels[key]?.[lang] || key;

// Plain-text hero intro (strip HTML tags from description)
// Suppress if the stripped text is just the title restated (degenerate API data)
const _heroIntroRaw = description.replace(/<[^>]*>/g, '').replace(/&[a-z]+;/gi, ' ').trim().slice(0, 260);
const heroIntro = _heroIntroRaw.toLowerCase() === title.toLowerCase() ? '' : _heroIntroRaw;

// Editorial body: work_story preferred, description as fallback
const bodyText = workStory || description;

// Werf photo grid — only real detailGallery entries, no fallback placeholders
type WerfPhoto = { url: string; label: string };
const werfImages: WerfPhoto[] = detailGallery
    .filter((img: any) => img?.url)
    .map((img: any, i: number) => ({
        url:   img.url,
        label: img.alt || [
            t['project.werf.label.overview'],
            t['project.werf.label.study'],
            t['project.werf.label.install'],
            t['project.werf.label.logistics'],
            t['project.werf.label.deliver'],
        ][i] || '',
    }));
---

<Layout title={pageTitle} lang={lang} pageSlug={pageSlug} description={pageMeta} ogImage={pageOgImage}>
    {featuredUrl && (
        <link slot="head" rel="preload" as="image" href={featuredUrl} fetchpriority="high" />
    )}

    <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
    <section class="relative min-h-[640px] overflow-hidden">

        <!-- Background image + gradient veil -->
        <div
            class="absolute inset-0 scale-[1.02] bg-cover bg-center bg-[#0f1014]"
            style={featuredUrl ? `background-image:url('${featuredUrl}')` : undefined}
        ></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#07080b]/75 via-[#07080b]/45 to-[#07080b]/15"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#07080b]/85 via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-obsidian to-transparent"></div>

        <!-- Two-column hero layout -->
        <div class="relative z-10 max-w-[1180px] mx-auto px-6 pt-36 pb-20
                    grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-10 lg:gap-16 items-end">

            <!-- LEFT: breadcrumb · tag · h1 · intro · CTAs · meta bar -->
            <div>
                <!-- Breadcrumb -->
                <nav class="flex flex-wrap items-center gap-2 text-white/45 text-[13px] mb-8" aria-label="breadcrumb">
                    <a href={backUrl} class="hover:text-white/70 transition-colors">{t['nav.projects']}</a>
                    <span aria-hidden="true">/</span>
                    {categoryLabel && <span class="text-white/45">{categoryLabel}</span>}
                </nav>

                <!-- Category + year tag -->
                <div class="inline-flex items-center gap-2 h-8 px-3 rounded-full
                            bg-lux-gold/15 border border-lux-gold/30
                            text-lux-gold text-[11px] font-bold uppercase tracking-wider mb-5">
                    <span class="w-1.5 h-1.5 rounded-full bg-lux-gold" aria-hidden="true"></span>
                    {categoryLabel}{year ? ` — ${year}` : ''}
                </div>

                <!-- Title -->
                <h1 class="font-display font-black text-white leading-[1.1] mt-2 mb-5
                           text-[36px] sm:text-[46px] lg:text-[56px]">
                    {title}
                </h1>

                <!-- Intro -->
                {heroIntro && (
                    <p class="text-white/70 text-lg sm:text-[19px] leading-relaxed mb-8 max-w-[620px]">
                        {heroIntro}
                    </p>
                )}

               

            </div>

            <!-- RIGHT: project info card -->
            <aside class="self-end lg:self-end">
                <div class="bg-[#080a0e]/[0.40] border border-white/12 rounded-lg p-6
                            backdrop-blur-md shadow-[0_24px_80px_rgba(0,0,0,0.4)]">
                    <p class="text-lux-gold text-[11px] font-bold uppercase tracking-widest mb-5">
                        {t['project.info.title']}
                    </p>

                    {categoryLabel && (
                        <div class="flex items-start justify-between gap-4 py-3.5 border-t border-white/8 text-[13px]">
                            <span class="text-white/50 shrink-0">{l('category')}</span>
                            <strong class="text-white text-right font-semibold">{categoryLabel}</strong>
                        </div>
                    )}
                    {location && (
                        <div class="flex items-start justify-between gap-4 py-3.5 border-t border-white/8 text-[13px]">
                            <span class="text-white/50 shrink-0">{l('location')}</span>
                            <strong class="text-white text-right font-semibold">{location}</strong>
                        </div>
                    )}
                    {year && (
                        <div class="flex items-start justify-between gap-4 py-3.5 border-t border-white/8 text-[13px]">
                            <span class="text-white/50 shrink-0">{l('year')}</span>
                            <strong class="text-white text-right font-semibold">{year}</strong>
                        </div>
                    )}
                    {client && (
                        <div class="flex items-start justify-between gap-4 py-3.5 border-t border-white/8 text-[13px]">
                            <span class="text-white/50 shrink-0">{l('client')}</span>
                            <strong class="text-white text-right font-semibold">{client}</strong>
                        </div>
                    )}

                </div>
            </aside>
        </div>
    </section>

    <!-- ─── MAIN CONTENT ─────────────────────────────────────────────────── -->
    <main class="bg-obsidian">
        <div class="max-w-[1180px] mx-auto px-6">

            <!-- ── LIVE CONTENT: body + highlights (client-side hydration) ── -->
            <ProjectLiveContent
                client:load
                slug={raw.slug}
                lang={lang}
                initial={{
                    bodyText,
                    challenge,
                    solution,
                    result,
                }}
            />

            <!-- ── WERFDETAILS: photo grid ──────────────────────────────── -->
            {werfImages.length > 0 && (
            <section class="py-16 border-b border-white/[0.06]">
                <div class="flex flex-wrap items-end justify-between gap-6 mb-6">
                    <div>
                        <p class="text-lux-gold text-[11px] font-bold uppercase tracking-widest mb-2">
                            {t['project.werf.kicker']}
                        </p>
                        <h2 class="font-display text-[30px] font-bold text-white leading-tight">
                            {t['project.werf.title']}
                        </h2>
                    </div>
                </div>

                <WerfGallery client:visible images={werfImages} title={title} />
            </section>
            )}

            <!-- ── GALERIJ: main project gallery ───────────────────────── -->
            {gallery.length > 0 && (
                <section class="py-16 border-b border-white/[0.06]">
                    <p class="text-lux-gold text-[11px] font-bold uppercase tracking-widest mb-2">
                        {t['project.gallery.kicker']}
                    </p>
                    <h2 class="font-display text-[30px] font-bold text-white mb-8 leading-tight">
                        {t['project.gallery']}
                    </h2>
                    <DetailGallery client:visible gallery={gallery} title={title} />
                </section>
            )}

            <!-- ── CTA BAND ─────────────────────────────────────────────── -->
            <section class="py-16">
                <div class="relative overflow-hidden rounded-lg border border-white/10 bg-[#121419] p-8 md:p-[34px_36px]
                            grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 md:gap-10 items-center">
                    <!-- Left gold glow -->
                    <div class="absolute inset-0 bg-gradient-to-r from-lux-gold/10 via-transparent to-transparent
                                pointer-events-none" aria-hidden="true"></div>

                    <div class="relative">
                        <h2 class="font-display text-[26px] md:text-[28px] font-bold text-white mb-2 leading-snug">
                            {t['services.cta.title']}
                        </h2>
                        <p class="text-white/50 text-[14px]">{t['contact.subtitle']}</p>
                    </div>

                    <div class="relative flex flex-wrap gap-3 items-center">
                        <a href="tel:+32473536591"
                           class="inline-flex items-center gap-2 px-6 py-3 rounded-full
                                  bg-lux-gold text-obsidian font-bold text-[12px] uppercase tracking-wide
                                  hover:bg-lux-gold/90 transition-colors whitespace-nowrap">
                            {t['contact.call']}
                        </a>
                        <a href={ctaUrl}
                           class="inline-flex items-center gap-2 px-6 py-3 rounded-full
                                  bg-white/5 border border-white/15 text-white font-bold text-[12px]
                                  uppercase tracking-wide hover:bg-white/10 transition-colors whitespace-nowrap">
                            {t['nav.cta']}
                        </a>
                    </div>
                </div>
            </section>

        </div>
    </main>
</Layout>
