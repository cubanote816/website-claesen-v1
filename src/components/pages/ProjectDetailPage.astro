---
import Layout from '../../layouts/Layout.astro';
import { ui, defaultLang } from '../../i18n/ui';

interface Props {
    project: any;
    lang?: string;
}

const { project: raw, lang = defaultLang } = Astro.props;
const t = ui[lang as keyof typeof ui] || ui[defaultLang];

function getStr(val: any): string {
    if (typeof val === 'string') return val;
    if (!val) return '';
    return val[lang] || val['nl'] || val['en'] || '';
}

function getImageUrl(val: any): string {
    if (!val) return '';
    if (typeof val === 'string') return val;
    return val.optimized || val.original || val.url || val.original_url || val.thumb || '';
}

const title      = getStr(raw.title);
const description = getStr(raw.description);
const location   = getStr(raw.location);
const client     = getStr(raw.client);
const category   = raw.category || '';
const year       = raw.year;
const featuredUrl = getImageUrl(raw.featured_image_url || raw.featured_image);

const rawGallery: any[] = Array.isArray(raw.gallery) && raw.gallery.length > 0
    ? raw.gallery
    : (Array.isArray(raw.api_gallery) ? raw.api_gallery : []);

const gallery = rawGallery
    .map((img: any) => ({
        url:   getImageUrl(img),
        thumb: img.thumb || img.thumb_url || getImageUrl(img),
        alt:   img.alt || title,
    }))
    .filter((img: any) => img.url);

const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const backUrl  = lang === defaultLang
    ? `${basePath}/#projects`
    : `${basePath}/${lang}/#projects`;
const ctaUrl   = lang === defaultLang
    ? `${basePath}/#contact`
    : `${basePath}/${lang}/#contact`;

const SITE_URL   = (import.meta.env.PUBLIC_SITE_URL || 'https://claesen-verlichting.be').replace(/\/$/, '');
const pageTitle  = `${title} — Claesen Verlichting`;
const pageMeta   = description.replace(/<[^>]+>/g, '').slice(0, 160);
const pageOgImage = featuredUrl || `${SITE_URL}${basePath}/assets/hero-bg.jpg`;
const pageSlug   = lang === defaultLang
    ? `/projecten/${raw.slug}`
    : `/${lang}/projecten/${raw.slug}`;

const categoryLabels: Record<string, Record<string, string>> = {
    sport:      { nl: 'Sport',           en: 'Sport',         fr: 'Sport',          de: 'Sport'              },
    industrial: { nl: 'Industrieel',     en: 'Industrial',    fr: 'Industriel',     de: 'Industrie'          },
    public:     { nl: 'Publieke Ruimte', en: 'Public Space',  fr: 'Espace Public',  de: 'Öffentlicher Raum'  },
};
const categoryLabel = categoryLabels[category]?.[lang] || category;

const sidebarLabels: Record<string, Record<string, string>> = {
    category: { nl: 'Categorie', en: 'Category',  fr: 'Catégorie', de: 'Kategorie' },
    location: { nl: 'Locatie',   en: 'Location',  fr: 'Lieu',      de: 'Standort'  },
    year:     { nl: 'Jaar',      en: 'Year',      fr: 'Année',     de: 'Jahr'      },
    client:   { nl: 'Klant',     en: 'Client',    fr: 'Client',    de: 'Kunde'     },
};
const l = (key: string) => sidebarLabels[key]?.[lang] || key;
---

<Layout title={pageTitle} lang={lang} pageSlug={pageSlug} description={pageMeta} ogImage={pageOgImage}>
    {featuredUrl && (
        <link slot="head" rel="preload" as="image" href={featuredUrl} fetchpriority="high" />
    )}

    <!-- Hero -->
    <section class="relative min-h-[65vh] flex items-end pb-16 overflow-hidden">
        <div
            class="absolute inset-0 bg-cover bg-center bg-gunmetal/80"
            style={featuredUrl ? `background-image:url('${featuredUrl}')` : undefined}
        ></div>
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/50 to-obsidian/10"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
            <div class="flex flex-wrap items-center gap-3 mb-6">
                {categoryLabel && (
                    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-lux-gold/20 text-lux-gold border border-lux-gold/30">
                        {categoryLabel}
                    </span>
                )}
                {location && (
                    <span class="flex items-center gap-1.5 text-sm text-white/60">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        {location}
                    </span>
                )}
                {year && (
                    <span class="flex items-center gap-1.5 text-sm text-white/60">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        {year}
                    </span>
                )}
            </div>

            <h1 class="font-display text-4xl md:text-6xl font-bold text-white mb-4 leading-tight max-w-4xl">
                {title}
            </h1>
            <div class="w-16 h-1 bg-lux-gold rounded-full"></div>
        </div>
    </section>

    <!-- Content -->
    <section class="bg-obsidian py-16">
        <div class="max-w-7xl mx-auto px-6">

            <!-- Nav bar -->
            <div class="flex items-center justify-between mb-12 flex-wrap gap-4">
                <a href={backUrl} class="flex items-center gap-2 text-sm text-white/60 hover:text-lux-gold transition-colors group">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:-translate-x-1 transition-transform" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                    {t['project.back']}
                </a>
                <a href={ctaUrl} class="px-6 py-3 bg-lux-gold text-obsidian font-bold text-sm rounded-full hover:bg-lux-gold/90 transition-colors">
                    {t['nav.cta']}
                </a>
            </div>

            <!-- Two-column layout -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

                <!-- Description -->
                <div class="lg:col-span-2">
                    {description && (
                        <div>
                            <h2 class="font-display text-2xl font-bold text-white mb-6">{t['portfolio.modal.about']}</h2>
                            <div
                                class="prose prose-invert prose-lg max-w-none text-white/70 leading-relaxed [&_p]:mb-4 [&_p:last-child]:mb-0"
                                set:html={description}
                            />
                        </div>
                    )}
                </div>

                <!-- Sidebar -->
                <aside>
                    <div class="p-6 rounded-2xl bg-white/5 border border-white/10 sticky top-24">
                        <h3 class="font-bold text-xs uppercase tracking-widest text-lux-gold/70 mb-5">Project Info</h3>
                        <dl class="space-y-4 text-sm">
                            {categoryLabel && (
                                <div class="flex justify-between gap-4">
                                    <dt class="text-white/50 shrink-0">{l('category')}</dt>
                                    <dd class="text-white font-medium text-right">{categoryLabel}</dd>
                                </div>
                            )}
                            {location && (
                                <div class="flex justify-between gap-4">
                                    <dt class="text-white/50 shrink-0">{l('location')}</dt>
                                    <dd class="text-white font-medium text-right">{location}</dd>
                                </div>
                            )}
                            {year && (
                                <div class="flex justify-between gap-4">
                                    <dt class="text-white/50 shrink-0">{l('year')}</dt>
                                    <dd class="text-white font-medium text-right">{year}</dd>
                                </div>
                            )}
                            {client && (
                                <div class="flex justify-between gap-4">
                                    <dt class="text-white/50 shrink-0">{l('client')}</dt>
                                    <dd class="text-white font-medium text-right">{client}</dd>
                                </div>
                            )}
                        </dl>
                        <div class="mt-6 pt-6 border-t border-white/10">
                            <a href={ctaUrl} class="block w-full text-center px-4 py-3 bg-lux-gold/10 border border-lux-gold/30 text-lux-gold font-bold text-sm rounded-xl hover:bg-lux-gold hover:text-obsidian transition-colors">
                                {t['nav.cta']}
                            </a>
                        </div>
                    </div>
                </aside>
            </div>

            <!-- Gallery -->
            {gallery.length > 0 && (
                <div class="mt-20">
                    <h2 class="font-display text-2xl font-bold text-white mb-8">{t['project.gallery']}</h2>
                    <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
                        {gallery.map((img: any, i: number) => (
                            <a
                                href={img.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block overflow-hidden rounded-xl border border-white/10 hover:border-lux-gold/40 transition-colors group break-inside-avoid"
                                aria-label={img.alt}
                            >
                                <img
                                    src={img.thumb || img.url}
                                    alt={img.alt}
                                    loading={i < 6 ? 'eager' : 'lazy'}
                                    decoding="async"
                                    class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
                                />
                            </a>
                        ))}
                    </div>
                </div>
            )}

            <!-- CTA band -->
            <div class="mt-20 p-10 rounded-3xl bg-white/5 border border-white/10 text-center">
                <h2 class="font-display text-2xl md:text-3xl font-bold text-white mb-3">
                    {t['services.cta.title']}
                </h2>
                <p class="text-white/50 mb-8">{t['contact.subtitle']}</p>
                <div class="flex flex-wrap justify-center gap-4">
                    <a href={`tel:+32473536591`} class="px-8 py-4 bg-lux-gold text-obsidian font-bold rounded-full hover:bg-lux-gold/90 transition-colors">
                        {t['contact.call']}
                    </a>
                    <a href={ctaUrl} class="px-8 py-4 bg-white/5 border border-white/20 text-white font-bold rounded-full hover:bg-white/10 transition-colors">
                        {t['nav.cta']}
                    </a>
                </div>
            </div>

        </div>
    </section>
</Layout>
