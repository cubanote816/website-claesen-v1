---
import Layout from "../../layouts/Layout.astro";
import PortfolioSection from "../sections/PortfolioSection.astro";
import ServicesSection from "../sections/ServicesSection.astro";
import WhyUsSection from "../sections/WhyUsSection.astro";
import AboutSection from "../sections/AboutSection.astro";
import QuickOfferteSection from "../sections/QuickOfferteSection.astro";
import ContactSection from "../sections/ContactSection.astro";
import TrustSection from "../sections/TrustSection.astro";
import TeamGallerySection from "../sections/TeamGallerySection.astro";
import Footer from "../Footer.astro";
import VideoModal from "../VideoModal";
import { ArrowDown, Play } from "lucide-react";
import { ui, defaultLang } from "../../i18n/ui";

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
---

<Layout title="Claesen Verlichting" lang={lang}>
  {/* Hero Section */}
  <section
    id="home"
    class="relative min-h-[100svh] w-full flex items-center justify-center overflow-hidden bg-obsidian transition-colors duration-700 pt-24 md:pt-0"
  >
    {/* Static Background Image */}
    <div
      id="hero-bg-image"
      class="absolute inset-0 z-0 bg-cover bg-center transition-opacity duration-1000 ease-in-out opacity-0"
      style="background-image: url('/v1/assets/hero-bg.jpg');"
    >
    </div>

    {/* Video Background (Initially Hidden) */}
    <video
      id="hero-video"
      class="absolute inset-0 z-0 w-full h-full object-cover opacity-100 transition-opacity duration-1000 ease-in-out"
      loop
      muted
      playsinline
      preload="auto"
      autoplay
      <source src="/v1/assets/hero-video.mp4" type="video/mp4" />
    </video>

    {/* Background Overlay */}
    <div
      class="absolute inset-0 z-0 bg-obsidian/60 lg:bg-obsidian/40 pointer-events-none"
    >
    </div>

    {/* Background Noise/Grid */}
    <div
      class="absolute inset-0 z-0 opacity-20 mix-blend-overlay pointer-events-none"
      style={{
        backgroundImage:
          "url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")",
        maskImage: "radial-gradient(circle at center, black, transparent 80%)",
      }}
    >
    </div>

    {/* Seamless Bottom Fade */}
    <div
      class="absolute bottom-0 left-0 w-full h-64 bg-gradient-to-t from-obsidian via-obsidian/80 to-transparent z-[5] pointer-events-none"
    >
    </div>

    {/* Media Toggle Hidden as per request */}
    {/* <div
      class="absolute right-6 bottom-12 md:top-1/2 md:-translate-y-1/2 z-20 flex flex-col items-center gap-2"
    >
      <button
        id="media-toggle"
        class="group relative w-12 h-12 flex items-center justify-center rounded-full border border-white/10 bg-white/5 backdrop-blur-md hover:bg-white/10 hover:scale-110 transition-all duration-300"
      >
        ...
      </button>
    </div> */}

    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
      <!-- <div class="inline-flex mb-8 items-center gap-3 px-4 py-2 rounded-full border border-lux-gold/20 bg-lux-gold/5 backdrop-blur-md text-lux-gold text-[10px] md:text-xs tracking-[0.3em] uppercase animate-fade-in-up">
        <span class="w-1.5 h-1.5 rounded-full bg-lux-gold animate-pulse"></span>
        Engineering Excellence
      </div> -->

      <div class="max-w-6xl mx-auto mb-10 md:mb-16 space-y-6 md:space-y-8">
        <h1
          class="font-display text-4xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[1.1] md:leading-[1] animate-fade-in"
        >
          <span
            class="block text-transparent bg-clip-text bg-gradient-to-b from-white to-white/60 drop-shadow-2xl"
          >
            {t["hero.title"]}
          </span>
        </h1>

        <p
          class="text-xl md:text-3xl lg:text-4xl text-lux-gold/90 font-light tracking-tight italic animate-fade-in-delayed px-4"
        >
          {t["hero.subtitle"]}
        </p>

        <p
          class="hidden md:block text-white/50 text-base md:text-lg max-w-2xl mx-auto leading-relaxed font-normal tracking-wide animate-fade-in-long px-8"
        >
          {t["hero.description"]}
        </p>
      </div>

      <div
        class="flex flex-col md:flex-row items-center justify-center gap-6 animate-fade-in-long"
      >
        <a
          href={`${
            import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL
          }/#contact`}
          class="group relative px-10 py-5 bg-lux-gold text-obsidian font-bold rounded-full overflow-hidden transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(212,175,55,0.3)]"
        >
          <span
            class="relative z-10 flex items-center gap-3 tracking-widest uppercase text-xs"
          >
            {t["hero.cta"]}
            <ArrowDown
              className="w-4 h-4 group-hover:translate-y-1 transition-transform"
            />
          </span>
          <div
            class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
          >
          </div>
        </a>

        <a
          href={`${
            import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL
          }/#projects`}
          class="px-10 py-5 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm hover:bg-white/10 transition-all flex items-center gap-4 group"
        >
          <span class="tracking-widest uppercase text-xs font-semibold"
            >{t["hero.explore"]}
          </span>
        </a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("astro:page-load", () => {
      const heroVideo = document.getElementById(
        "hero-video"
      ) as HTMLVideoElement;

      if (heroVideo) {
        heroVideo.play().catch((e) => console.log("Video autoplay failed", e));
      }

      // Logic for Showreel Button Event (Moved to PortfolioSection)
    });
  </script>

  <WhyUsSection lang={lang} />
  <PortfolioSection lang={lang} />
  <QuickOfferteSection lang={lang} />
  <ServicesSection lang={lang} />
  <AboutSection lang={lang} />
  <TrustSection lang={lang} />
  <TeamGallerySection lang={lang} />
  <ContactSection lang={lang} />
  <Footer lang={lang} />

  <VideoModal
    client:load
    videoUrl={`${
      import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL
    }/assets/hero-video.mp4`}
  />
</Layout>
