---
import PageHeader from '../PageHeader';
import { Lightbulb, Settings, FileText, Activity, ArrowRight } from 'lucide-react';
import { ui, defaultLang } from '../../i18n/ui';

export interface Props {
    lang?: keyof typeof ui;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];

const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const gl = (path: string) => {
    const route = lang === defaultLang ? path : `/${lang}${path}`;
    return `${baseUrl}${route}`;
};
---

<section id="services" class="py-20 px-6 relative">
  <div class="max-w-7xl mx-auto">
    <PageHeader
      client:visible
      title={t['services.title']}
      subtitle={t['services.subtitle']}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* Service 1: Relighting */}
      <div class="group relative p-8 rounded-3xl bg-gunmetal border border-white/10 overflow-hidden hover:border-lux-gold/40 transition-colors duration-500">
        <div class="absolute inset-0 bg-gradient-to-br from-lux-gold/8 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="w-14 h-14 bg-lux-gold/10 rounded-2xl flex items-center justify-center mb-6 text-lux-gold group-hover:scale-110 transition-transform duration-300">
            <Lightbulb className="w-7 h-7" />
          </div>
          <h3 class="font-display text-xl font-bold mb-3 text-white">{t['services.relighting.title']}</h3>
          <p class="text-white/65 leading-relaxed mb-6 text-[15px] flex-1">
            {t['services.relighting.desc']}
          </p>
          <a href={gl("/#contact")} class="inline-flex items-center gap-1.5 text-lux-gold text-[13px] font-semibold hover:gap-2.5 transition-all duration-200 w-fit">
            {t['contact.call'].replace('Nu B', 'Meer i').replace('ellen', 'nfo')} <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      {/* Service 2: New Projects */}
      <div class="group relative p-8 rounded-3xl bg-gunmetal border border-white/10 overflow-hidden hover:border-blue-400/40 transition-colors duration-500">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-500/8 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="w-14 h-14 bg-blue-500/10 rounded-2xl flex items-center justify-center mb-6 text-blue-400 group-hover:scale-110 transition-transform duration-300">
            <Settings className="w-7 h-7" />
          </div>
          <h3 class="font-display text-xl font-bold mb-3 text-white">{t['services.newprojects.title']}</h3>
          <p class="text-white/65 leading-relaxed mb-6 text-[15px] flex-1">
            {t['services.newprojects.desc']}
          </p>
          <a href={gl("/#contact")} class="inline-flex items-center gap-1.5 text-blue-400 text-[13px] font-semibold hover:gap-2.5 transition-all duration-200 w-fit">
            Meer info <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      {/* Service 3: Light Studies */}
      <div class="group relative p-8 rounded-3xl bg-gunmetal border border-white/10 overflow-hidden hover:border-green-400/40 transition-colors duration-500">
        <div class="absolute inset-0 bg-gradient-to-br from-green-500/8 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="w-14 h-14 bg-green-500/10 rounded-2xl flex items-center justify-center mb-6 text-green-400 group-hover:scale-110 transition-transform duration-300">
            <FileText className="w-7 h-7" />
          </div>
          <h3 class="font-display text-xl font-bold mb-3 text-white">{t['services.studies.title']}</h3>
          <p class="text-white/65 leading-relaxed mb-6 text-[15px] flex-1">
            {t['services.studies.desc']}
          </p>
          <a href={gl("/#contact")} class="inline-flex items-center gap-1.5 text-green-400 text-[13px] font-semibold hover:gap-2.5 transition-all duration-200 w-fit">
            Meer info <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      {/* Service 4: Maintenance */}
      <div class="group relative p-8 rounded-3xl bg-gunmetal border border-white/10 overflow-hidden hover:border-purple-400/40 transition-colors duration-500">
        <div class="absolute inset-0 bg-gradient-to-br from-purple-500/8 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex flex-col h-full">
          <div class="w-14 h-14 bg-purple-500/10 rounded-2xl flex items-center justify-center mb-6 text-purple-400 group-hover:scale-110 transition-transform duration-300">
            <Activity className="w-7 h-7" />
          </div>
          <h3 class="font-display text-xl font-bold mb-3 text-white">{t['services.maintenance.title']}</h3>
          <p class="text-white/65 leading-relaxed mb-6 text-[15px] flex-1">
            {t['services.maintenance.desc']}
          </p>
          <a href={gl("/#contact")} class="inline-flex items-center gap-1.5 text-purple-400 text-[13px] font-semibold hover:gap-2.5 transition-all duration-200 w-fit">
            Meer info <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </div>

    {/* CTA Repeat */}
    <div class="mt-12 flex flex-col items-center justify-center text-center animate-fade-in-up">
        <h4 class="text-2xl font-bold font-display mb-3">{t['services.cta.title']}</h4>
        <p class="text-white/55 text-[15px] mb-8 max-w-md">{t['offerte.subtitle']}</p>
        <a
            href={gl("/#contact")}
            class="group relative px-10 py-5 bg-lux-gold text-obsidian font-bold rounded-full overflow-hidden transition-all hover:scale-105 shadow-[0_0_24px_rgba(252,211,77,0.2)] hover:shadow-[0_0_36px_rgba(252,211,77,0.35)]"
        >
            <span class="relative z-10 uppercase tracking-widest text-xs flex items-center gap-3">
                {t['services.cta.button']}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
            </span>
            <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
        </a>
    </div>
  </div>
</section>
