---
import PageHeader from '../PageHeader';
import ModernPortfolio from '../ModernPortfolio';
import { ui, defaultLang } from '../../i18n/ui';
import { Play } from 'lucide-react';

interface Props {
  lang?: keyof typeof ui;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang as keyof typeof ui] || ui[defaultLang];
---

<section id="projects" class="min-h-screen py-20 px-6 relative bg-obsidian">
  <div class="max-w-7xl mx-auto">
    {/* Header */}
    <div class="relative mb-16">
      <PageHeader 
        client:visible
        title={t['portfolio.title']}
        subtitle={t['portfolio.subtitle']}
      />
      
      <div class="flex justify-center -mt-8 animate-fade-in-delayed">
        <button
          id="portfolio-showreel-btn"
          class="px-8 py-4 rounded-full border border-white/10 bg-white/5 backdrop-blur-md hover:bg-white/10 hover:scale-105 transition-all duration-300 flex items-center gap-4 group"
        >
          <div
            class="w-8 h-8 rounded-full bg-lux-gold/20 flex items-center justify-center group-hover:scale-110 transition-transform border border-lux-gold/30"
          >
            <Play className="w-3 h-3 fill-lux-gold text-lux-gold ml-0.5" />
          </div>
          <span class="tracking-widest uppercase text-[10px] font-bold"
            >{t["hero.showreel"]}
          </span>
        </button>
      </div>
    </div>

    {/* Grid */}
    <ModernPortfolio client:visible lang={lang} />
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const showreelBtn = document.getElementById("portfolio-showreel-btn");
    if (showreelBtn) {
      showreelBtn.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open-showreel"));
      });
    }
  });
</script>
