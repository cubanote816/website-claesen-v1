---
import PageHeader from '../PageHeader';
import { Send, User, Building2, Lightbulb } from 'lucide-react';
import { ui, defaultLang } from '../../i18n/ui';

export interface Props {
    lang?: keyof typeof ui;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
---

<section id="quick-offerte" class="py-24 px-6 relative overflow-hidden bg-gunmetal">
  {/* Background decoration */}
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-lux-gold/5 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-white/5 blur-[100px] rounded-full"></div>
  </div>

  <div class="max-w-4xl mx-auto relative z-10 text-center">
    <PageHeader 
      client:visible 
      title={t['offerte.title']} 
      subtitle={t['offerte.subtitle']}
    />

    <div class="mt-12 bg-obsidian/40 backdrop-blur-xl border border-white/10 p-8 md:p-12 rounded-[40px] shadow-2xl">
        <form class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
            <div class="space-y-2">
                <label class="block text-xs font-bold uppercase tracking-widest text-lux-gold/80 ml-1">{t['offerte.name']}</label>
                <div class="relative group">
                    <div class="absolute left-4 top-1/2 -translate-y-1/2 text-white/30 group-focus-within:text-lux-gold transition-colors">
                        <User className="w-5 h-5" />
                    </div>
                    <input 
                        type="text" 
                        placeholder="John Doe" 
                        class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 pl-12 pr-4 text-white focus:outline-none focus:border-lux-gold focus:bg-white/10 transition-all"
                    />
                </div>
            </div>

            <div class="space-y-2">
                <label class="block text-xs font-bold uppercase tracking-widest text-lux-gold/80 ml-1">{t['offerte.company']}</label>
                <div class="relative group">
                    <div class="absolute left-4 top-1/2 -translate-y-1/2 text-white/30 group-focus-within:text-lux-gold transition-colors">
                        <Building2 className="w-5 h-5" />
                    </div>
                    <input 
                        type="text" 
                        placeholder="Company Name" 
                        class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 pl-12 pr-4 text-white focus:outline-none focus:border-lux-gold focus:bg-white/10 transition-all"
                    />
                </div>
            </div>

            <div class="space-y-2">
                <label class="block text-xs font-bold uppercase tracking-widest text-lux-gold/80 ml-1">{t['offerte.projectType']}</label>
                <div class="relative group">
                    <div class="absolute left-4 top-1/2 -translate-y-1/2 text-white/30 group-focus-within:text-lux-gold transition-colors">
                        <Lightbulb className="w-5 h-5" />
                    </div>
                    <select class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 pl-12 pr-4 text-white focus:outline-none focus:border-lux-gold focus:bg-white/10 transition-all appearance-none">
                        <option value="" disabled selected>{t['form.projectType.placeholder']}</option>
                        <option value="sport" class="bg-obsidian">{t['form.projectType.sport']}</option>
                        <option value="industrial" class="bg-obsidian">{t['form.projectType.industrial']}</option>
                        <option value="public" class="bg-obsidian">{t['form.projectType.public']}</option>
                    </select>
                    <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/30">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
                    </div>
                </div>
            </div>

            <div class="md:col-span-3 mt-4">
                <button 
                    type="submit"
                    class="w-full group relative overflow-hidden bg-lux-gold text-obsidian font-bold py-5 rounded-2xl transition-all hover:scale-[1.02] active:scale-[0.98] shadow-xl shadow-lux-gold/10 flex items-center justify-center gap-3"
                >
                    <span class="relative z-10 flex items-center gap-2 uppercase tracking-[0.2em] text-sm">
                        {t['offerte.button']}
                        <Send className="w-4 h-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
                    </span>
                    <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                </button>
                <p class="mt-4 text-white/40 text-[10px] uppercase tracking-widest">
                    {t['offerte.disclaimer']}
                </p>
            </div>
        </form>
    </div>
  </div>
</section>

<script>
    import { consultationService } from '../../services/consultation';

    document.addEventListener("astro:page-load", () => {
        const form = document.querySelector('#quick-offerte form') as HTMLFormElement;
        if (!form) return;

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
            if (!button) return;

            const originalContent = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '<span class="animate-spin w-5 h-5 border-2 border-obsidian border-t-transparent rounded-full"></span>';

            const formData = new FormData(form);
            const data = {
                name: (form.querySelector('input[placeholder="John Doe"]') as HTMLInputElement)?.value,
                company: (form.querySelector('input[placeholder="Company Name"]') as HTMLInputElement)?.value,
                projectType: (form.querySelector('select') as HTMLSelectElement)?.value,
                email: 'lead-from-quick-form@claesen.be', // Placeholder since it's not in this simplified form but required by service
                message: 'Quick Quote Request from Landing Page',
                type: 'quick_offerte'
            };

            try {
                await consultationService.sendConsultation(data);
                button.innerHTML = '✓ Verzonden!';
                button.classList.replace('bg-lux-gold', 'bg-green-500');
                button.classList.add('text-white');
                form.reset();
                setTimeout(() => {
                    button.innerHTML = originalContent;
                    button.disabled = false;
                    button.classList.replace('bg-green-500', 'bg-lux-gold');
                    button.classList.remove('text-white');
                }, 5000);
            } catch (error) {
                console.error(error);
                button.innerHTML = 'Error! Probeer opnieuw';
                button.classList.replace('bg-lux-gold', 'bg-red-500');
                button.classList.add('text-white');
                setTimeout(() => {
                    button.innerHTML = originalContent;
                    button.disabled = false;
                    button.classList.replace('bg-red-500', 'bg-lux-gold');
                    button.classList.remove('text-white');
                }, 3000);
            }
        });
    });
</script>
