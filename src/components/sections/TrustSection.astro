---
import PageHeader from "../PageHeader";
import { ui, defaultLang } from "../../i18n/ui";
import { Trophy, CheckCircle2, ShieldCheck, Award } from "lucide-react";

import fs from "node:fs";
import path from "node:path";

export interface Props {
    lang?: keyof typeof ui;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];

// Dynamic logo detection
const logosDir = path.join(process.cwd(), "public/assets/logo_partner");
let files: string[] = [];
try {
    if (fs.existsSync(logosDir)) {
        files = fs
            .readdirSync(logosDir)
            .filter((f) => /\.(png|jpg|jpeg|webp|svg)$/i.test(f));
    }
} catch (e) {
    console.warn("TrustSection: Could not read logos directory", e);
}

// Mappings for files whose names don't format cleanly
const nameMapping: Record<string, string> = {
    "Picture06.png": "Infrabel",
};

const seenNames = new Set<string>();
const clients = files
    // Remove duplicate files (e.g. "Club (2).png" duplicates "Club.png")
    .filter((file) => !/ \(\d+\)\./.test(file))
    .map((file) => {
        // 1. Check explicit mapping
        if (nameMapping[file])
            return {
                name: nameMapping[file],
                logo: `/assets/logo_partner/${encodeURIComponent(file)}`,
            };

        // 2. Format filename (e.g., anderlecht.png -> Anderlecht)
        let name = file
            .replace(/\.[^/.]+$/, "") // remove extension
            .replace(/[-_]/g, " ") // replace dashes/underscores with space
            .replace(/\b\w/g, (l) => l.toUpperCase()); // capitalize first letter of each word

        // 3. Fallback for still-generic "PictureXX" names
        if (name.startsWith("Picture")) {
            name = name.replace("Picture", "Partner ");
        }

        return { name, logo: `/assets/logo_partner/${encodeURIComponent(file)}` };
    })
    // Deduplicate by name (keeps first occurrence, alphabetical by filename)
    .filter(({ name }) => {
        if (seenNames.has(name)) return false;
        seenNames.add(name);
        return true;
    });

const certifications = [
    { name: "ISO 9001", icon: ShieldCheck, desc: "Quality Management" },
    { name: "VCA**", icon: CheckCircle2, desc: "Safety Certified" },
    { name: "CE Certified", icon: Award, desc: "EU Standards" },
];
---

<section id="trust" class="py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <PageHeader
            client:visible
            title={t["trust.title"]}
            subtitle={t["trust.subtitle"]}
        />

        {/* Authority Highlights Row */}
        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
            <div
                class="p-6 rounded-2xl bg-white/5 border border-white/5 flex flex-col items-center text-center group hover:bg-lux-gold/10 hover:border-lux-gold/30 transition-all duration-500"
            >
                <div
                    class="text-lux-gold mb-4 group-hover:scale-110 transition-transform"
                >
                    <Trophy className="w-8 h-8" />
                </div>
                <h3 class="font-bold text-3xl mb-1 text-white">85+</h3>
                <p
                    class="text-[10px] uppercase tracking-widest text-lux-gold/70 font-bold"
                >
                    {t["about.stats.years"]}
                </p>
            </div>

            <div
                class="p-6 rounded-2xl bg-white/5 border border-white/5 flex flex-col items-center text-center group hover:bg-lux-gold/10 hover:border-lux-gold/30 transition-all duration-500"
            >
                <div
                    class="text-blue-400 mb-4 group-hover:scale-110 transition-transform"
                >
                    <CheckCircle2 className="w-8 h-8" />
                </div>
                <h3 class="font-bold text-3xl mb-1 text-white">500+</h3>
                <p
                    class="text-[10px] uppercase tracking-widest text-blue-400/70 font-bold"
                >
                    {t["about.stats.projects"]}
                </p>
            </div>

            <div
                class="p-6 rounded-2xl bg-white/5 border border-white/5 flex flex-col items-center text-center group hover:bg-lux-gold/10 hover:border-lux-gold/30 transition-all duration-500"
            >
                <div
                    class="text-green-400 mb-4 group-hover:scale-110 transition-transform"
                >
                    <ShieldCheck className="w-8 h-8" />
                </div>
                <h3 class="font-bold text-3xl mb-1 text-white">VCA*</h3>
                <p
                    class="text-[10px] uppercase tracking-widest text-green-400/70 font-bold"
                >
                    {t["about.stats.cert"]}
                </p>
            </div>

            <div
                class="p-6 rounded-2xl bg-white/5 border border-white/5 flex flex-col items-center text-center group hover:bg-lux-gold/10 hover:border-lux-gold/30 transition-all duration-500"
            >
                <div
                    class="text-purple-400 mb-4 group-hover:scale-110 transition-transform"
                >
                    <Award className="w-8 h-8" />
                </div>
                <h3 class="font-bold text-3xl mb-1 text-white">10Yr</h3>
                <p
                    class="text-[10px] uppercase tracking-widest text-purple-400/70 font-bold"
                >
                    {t["about.stats.warranty"]}
                </p>
            </div>
        </div>

        {/* Logo Marquee with Center Focus Effect */}
        <div
            class="relative py-12 marquee-container overflow-hidden bg-transparent"
        >
            {/* The single source of truth - One marquee, perfect sharpness */}
            <div
                class="animate-marquee flex whitespace-nowrap items-center bg-transparent"
            >
                {
                    [...clients, ...clients, ...clients].map((client) => (
                        <div class="mx-12 md:mx-16 flex flex-col items-center justify-center cursor-default shrink-0">
                            <img
                                src={`${
                                    import.meta.env.BASE_URL === "/"
                                        ? ""
                                        : import.meta.env.BASE_URL
                                }${client.logo}`}
                                alt={client.name}
                                loading="lazy"
                                decoding="async"
                                class="h-10 md:h-14 w-auto object-contain logo-img"
                            />
                            <span class="text-[10px] uppercase tracking-[0.3em] text-white/50 mt-4 font-bold">
                                {client.name}
                            </span>
                        </div>
                    ))
                }
            </div>

            {/* Fixed Grayscale Overlays using backdrop-filter */}
            <div
                class="absolute inset-y-0 left-0 w-[42%] z-20 pointer-events-none backdrop-gray-left bg-transparent"
            >
            </div>
            <div
                class="absolute inset-y-0 right-0 w-[42%] z-20 pointer-events-none backdrop-gray-right bg-transparent"
            >
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    .animate-marquee {
        animation: marquee 10s linear infinite;
        will-change: transform;
    }

    .marquee-container:hover .animate-marquee {
        animation-play-state: paused;
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-marquee {
            animation: none;
        }
    }

    /* Backdrop Filter Overlays for perfect sync grayscale */
    .backdrop-gray-left {
        backdrop-filter: grayscale(100%);
        -webkit-backdrop-filter: grayscale(100%);
        -webkit-mask-image: linear-gradient(
            to right,
            black 60%,
            transparent 100%
        );
        mask-image: linear-gradient(to right, black 60%, transparent 100%);
    }

    .backdrop-gray-right {
        backdrop-filter: grayscale(100%);
        -webkit-backdrop-filter: grayscale(100%);
        -webkit-mask-image: linear-gradient(
            to left,
            black 60%,
            transparent 100%
        );
        mask-image: linear-gradient(to left, black 60%, transparent 100%);
    }

    /* Sharpness and Rendering Optimization */
    .logo-img {
        image-rendering: -webkit-optimize-contrast;
        image-rendering: crisp-edges;
        transform: translateZ(0);
        backface-visibility: hidden;
        filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.05));
    }
</style>
