---
import PageHeader from '../PageHeader';
import { ui, defaultLang } from '../../i18n/ui';
import { Trophy, CheckCircle2, ShieldCheck, Award } from 'lucide-react';

export interface Props {
    lang?: keyof typeof ui;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];

// Placeholder for client logos - in a real scenario, these would be SVG/PNG files in public/assets/logos/
const clients = [
    { name: 'Infrabel', logo: '/assets/logos/logo2.png' },
    { name: 'KRC Genk', logo: '/assets/logos/logo1.png' },
    { name: 'STVV', logo: '/assets/logos/logo1.png' },
    { name: 'KAA Gent', logo: '/assets/logos/logo1.png' },
    { name: 'Sport Vlaanderen', logo: '/assets/logos/logo2.png' },
    { name: 'Limburg.be', logo: '/assets/logos/logo2.png' },
    { name: 'Standard Liège', logo: '/assets/logos/logo1.png' },
    { name: 'Club Brugge', logo: '/assets/logos/logo1.png' },
];

const certifications = [
    { name: 'ISO 9001', icon: ShieldCheck, desc: 'Quality Management' },
    { name: 'VCA**', icon: CheckCircle2, desc: 'Safety Certified' },
    { name: 'CE Certified', icon: Award, desc: 'EU Standards' },
];
---

<section id="trust" class="py-24 bg-gunmetal/30 relative overflow-hidden border-y border-white/5">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <PageHeader 
            client:visible 
            title={t['trust.title']} 
            subtitle={t['trust.subtitle']}
        />

        {/* Authority Highlights Row */}
        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5 flex flex-col items-center text-center group hover:bg-lux-gold/10 hover:border-lux-gold/30 transition-all duration-500">
                <div class="text-lux-gold mb-4 group-hover:scale-110 transition-transform">
                    <Trophy className="w-8 h-8" />
                </div>
                <h3 class="font-bold text-3xl mb-1 text-white">50+</h3>
                <p class="text-[10px] uppercase tracking-widest text-lux-gold/70 font-bold">{t['about.stats.years']}</p>
            </div>

            <div class="p-6 rounded-2xl bg-white/5 border border-white/5 flex flex-col items-center text-center group hover:bg-lux-gold/10 hover:border-lux-gold/30 transition-all duration-500">
                <div class="text-blue-400 mb-4 group-hover:scale-110 transition-transform">
                    <CheckCircle2 className="w-8 h-8" />
                </div>
                <h3 class="font-bold text-3xl mb-1 text-white">1000+</h3>
                <p class="text-[10px] uppercase tracking-widest text-blue-400/70 font-bold">{t['about.stats.projects']}</p>
            </div>

            <div class="p-6 rounded-2xl bg-white/5 border border-white/5 flex flex-col items-center text-center group hover:bg-lux-gold/10 hover:border-lux-gold/30 transition-all duration-500">
                <div class="text-green-400 mb-4 group-hover:scale-110 transition-transform">
                    <ShieldCheck className="w-8 h-8" />
                </div>
                <h3 class="font-bold text-3xl mb-1 text-white">EU</h3>
                <p class="text-[10px] uppercase tracking-widest text-green-400/70 font-bold">{t['about.stats.cert']}</p>
            </div>

            <div class="p-6 rounded-2xl bg-white/5 border border-white/5 flex flex-col items-center text-center group hover:bg-lux-gold/10 hover:border-lux-gold/30 transition-all duration-500">
                <div class="text-purple-400 mb-4 group-hover:scale-110 transition-transform">
                    <Award className="w-8 h-8" />
                </div>
                <h3 class="font-bold text-3xl mb-1 text-white">10Yr</h3>
                <p class="text-[10px] uppercase tracking-widest text-purple-400/70 font-bold">{t['about.stats.warranty']}</p>
            </div>
        </div>

        {/* Logo Marquee */}
        <div class="mt-20 relative">
            <div class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-obsidian to-transparent z-10"></div>
            <div class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-obsidian to-transparent z-10"></div>
            
            <div class="flex overflow-hidden group">
                <div class="flex animate-marquee whitespace-nowrap py-12 items-center">
                    {[...clients, ...clients].map((client) => (
                        <div class="mx-16 flex flex-col items-center justify-center grayscale opacity-40 hover:grayscale-0 hover:opacity-100 transition-all duration-500 cursor-default">
                            <img 
                                src={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}${client.logo}`} 
                                alt={client.name} 
                                class="h-12 md:h-16 w-auto object-contain"
                            />
                            <span class="text-[10px] uppercase tracking-[0.3em] text-white/30 mt-4 font-bold">{client.name}</span>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .animate-marquee {
        animation: marquee 30s linear infinite;
    }

    .animate-marquee:hover {
        animation-play-state: paused;
    }
</style>
