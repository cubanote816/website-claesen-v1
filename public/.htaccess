Options -Indexes

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html text/plain text/css \
        application/javascript application/json \
        image/svg+xml font/woff2
</IfModule>

# ── ETags (use MTime + Size, not inode — safe for multi-server) ───────────────
FileETag MTime Size

# ── Cache headers ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>

    # Astro hashed assets (JS, CSS, fonts) — immutable, 1 year
    # Astro appends a content hash to every filename so these never go stale.
    <FilesMatch "\.(js|css|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Gallery images (/v1-media/) — 30 days.
    # Re-running `npm run sync:clean` + re-deploy replaces files, so 30 days is safe.
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # SVG treated separately — can be HTML-like, keep shorter TTL
    <FilesMatch "\.svg$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # projects-static.json — 1 hour, must revalidate.
    # Used as API fallback; should reflect recent content updates.
    <FilesMatch "projects-static\.json$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
        Header unset ETag
    </FilesMatch>

    # HTML pages — always revalidate (content changes on every deploy)
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset ETag
    </FilesMatch>

    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

</IfModule>

# ── MIME types ────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType image/webp  .webp
    AddType image/avif  .avif
    AddType font/woff2  .woff2
</IfModule>
